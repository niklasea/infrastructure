# Keep the Ghidra download and runtime stages on the same Debian release.
ARG DEBIAN_VERSION=bookworm

# Ghidra 12.2 requires JDK 25; the Jammy build runs on Bookworm's newer glibc.
FROM eclipse-temurin:25.0.5.1_2-jdk-jammy AS java

FROM debian:${DEBIAN_VERSION}-slim AS ghidra
ARG GHIDRA_VERSION=12.2
ARG GHIDRA_ARCHIVE=ghidra_12.2_PUBLIC_20261016.zip
# Keep the digest paired with GHIDRA_ARCHIVE.
ARG GHIDRA_SHA256=2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/ghidra.zip \
    "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/${GHIDRA_ARCHIVE}" \
  && echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c - \
  && unzip -q /tmp/ghidra.zip -d /opt \
  && mv "/opt/ghidra_${GHIDRA_VERSION}_PUBLIC" /opt/ghidra \
  && chmod +x /opt/ghidra/support/analyzeHeadless \
  && rm /tmp/ghidra.zip

FROM debian:${DEBIAN_VERSION}-slim
ARG NODE_VERSION=24.22.3
# Keep the digest paired with NODE_VERSION.
ARG NODE_SHA256=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
ARG REA_AGENTS_VERSION=6.10.1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Ghidra ships its native decompiler only for linux-amd64.
RUN [ "$(dpkg --print-architecture)" = "amd64" ] \
  || (echo "REA requires amd64 for Ghidra" >&2 && false)

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    binutils \
    ca-certificates \
    curl \
    fontconfig \
    libfreetype6 \
    libstdc++6 \
    libx11-6 \
    libxext6 \
    libxi6 \
    libxrender1 \
    libxtst6 \
    procps \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

COPY --from=java /opt/java/openjdk /opt/java/openjdk
COPY --from=ghidra /opt/ghidra /opt/ghidra

RUN curl -fsSL -o /tmp/node.tar.xz \
    "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
  && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
  && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
  && rm /tmp/node.tar.xz \
  && npm install --global --ignore-scripts --no-audit --no-fund "rea-agents@${REA_AGENTS_VERSION}" \
  && npm cache clean --force \
  && apt-get purge -y --auto-remove curl \
  && rm -rf /var/lib/apt/lists/*

ENV GHIDRA_INSTALL_DIR=/opt/ghidra \
    HOME=/home/rea \
    JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# Java derives user.home from passwd rather than $HOME; Ghidra needs it writable.
# usermod refuses to change a user with running processes, so edit passwd directly.
RUN mkdir -p /home/rea \
  && sed -i 's|^root:x:0:0:root:/root:|root:x:0:0:root:/home/rea:|' /etc/passwd \
  && grep -q '^root:x:0:0:root:/home/rea:' /etc/passwd \
  && ps -p 1 -o pid=,ppid=,pgid=,uid=,stat=,command= >/dev/null \
  && java -version \
  && javac -version \
  && test -x "${GHIDRA_INSTALL_DIR}/support/analyzeHeadless" \
  && test -x "${GHIDRA_INSTALL_DIR}/Ghidra/Features/Decompiler/os/linux_x86_64/decompile" \
  && rea --version

# The bind-mounted home is owned by the remap user that container root maps to.
USER root

EXPOSE 8765

ENTRYPOINT ["rea"]
