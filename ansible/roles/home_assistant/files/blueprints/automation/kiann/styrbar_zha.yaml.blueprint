# Vendored from https://community.home-assistant.io/t/854854/16 (kiann).
# Local modifications: targets restricted to lights, and the dimming loop is
# bounded so a lost stop event cannot run it indefinitely.
blueprint:
  name: IKEA Styrbar (ZHA) - Smooth & Complete
  description: "ZHA Styrbar with absolute dimming, selection flash, and smooth transitions."
  domain: automation
  input:
    switch_remote:
      name: Styrbar switch remote
      selector:
        device:
          integration: zha
    targets:
      name: Light Entities
      selector:
        entity:
          multiple: true
          filter:
            - domain: [light]
    selected_target:
      name: Target Index Helper
      selector:
        entity:
          domain: input_number
    enable_flash:
      name: Enable Selection Flash
      default: true
      selector:
        boolean: {}
    force_brightness:
      name: Force Brightness
      default: false
      selector:
        boolean: {}
    brightness_pct:
      name: Forced Brightness Level (%)
      default: 50
      selector:
        number: {min: 0, max: 100, mode: slider}
    repeat_delay:
      name: Dimming Speed (ms)
      default: 150
      selector:
        number: {min: 50, max: 1000, step: 10, mode: slider}
    brightness_step_pct:
      name: Dimming Step (%)
      default: 10
      selector:
        number: {min: 1, max: 100, mode: slider}
    transition_time:
      name: Transition Smoothness (s)
      description: "How long the bulb takes to reach the next brightness level. Try 0.2 to 0.4 for smoothness."
      default: 0.3
      selector:
        number: {min: 0, max: 2, step: 0.1, mode: slider}
    arrow_left_hold:
      name: Long press - left
      default: []
      selector: {action: {}}
    arrow_left_release:
      name: Release press - left
      default: []
      selector: {action: {}}
    arrow_right_hold:
      name: Long press - right
      default: []
      selector: {action: {}}
    arrow_right_release:
      name: Release press - right
      default: []
      selector: {action: {}}

mode: restart

trigger:
  - platform: event
    event_type: zha_event
    event_data:
      device_id: !input switch_remote

action:
  - variables:
      target_entities: !input targets
      helper: !input selected_target
      flash_enabled: !input enable_flash
      force_br: !input force_brightness
      br_val: !input brightness_pct
      step_val: !input brightness_step_pct
      delay_val: !input repeat_delay
      trans_val: !input transition_time

      # Event Data
      command: "{{ trigger.event.data.command }}"
      cluster_id: "{{ trigger.event.data.cluster_id | int }}"
      args: "{{ trigger.event.data.args }}"

      # Determine active entity
      current_idx: "{{ states(helper) | int(0) }}"
      active_entity: "{{ target_entities[current_idx] if current_idx < target_entities | count else target_entities[0] }}"

  - choose:
      # 1. CYCLING (Cluster 5)
      - conditions: "{{ command == 'press' and cluster_id == 5 }}"
        sequence:
          - variables:
              is_right: "{{ args[0] == 256 }}"
              new_idx: >
                {% if is_right %} {{ (current_idx + 1) % target_entities | count }}
                {% else %} {{ (current_idx - 1 + target_entities | count) % target_entities | count }}
                {% endif %}
          - service: input_number.set_value
            data:
              entity_id: "{{ helper }}"
              value: "{{ new_idx }}"
          - condition: template
            value_template: "{{ flash_enabled }}"
          - service: light.turn_on
            target: { entity_id: "{{ target_entities[new_idx] }}" }
            data: { flash: short }
            continue_on_error: true

      # 2. POWER (Cluster 6)
      - conditions: "{{ command in ['on', 'off'] }}"
        sequence:
          - service: "homeassistant.turn_{{ command }}"
            target: { entity_id: "{{ active_entity }}" }
            data: >
              {% if command == 'on' and active_entity.split('.')[0] == 'light' and force_br %}
                {"brightness_pct": {{ br_val }}, "transition": {{ trans_val }}}
              {% elif command == 'on' and active_entity.split('.')[0] == 'light' %}
                {"transition": {{ trans_val }}}
              {% else %} {} {% endif %}

      # 3. DIMMING (Cluster 8)
      - conditions: "{{ command == 'move' and cluster_id == 8 }}"
        sequence:
          - repeat:
              count: 200
              sequence:
                - variables:
                    is_up: "{{ args[0] == 0 }}"
                    current_br: "{{ state_attr(active_entity, 'brightness') | int(0) }}"
                    new_br: >
                      {% if is_up %} {{ [current_br + (step_val * 2.55), 255] | min | int }}
                      {% else %} {{ [current_br - (step_val * 2.55), 15] | max | int }}
                      {% endif %}

                - condition: template
                  value_template: "{{ is_up or current_br > 15 }}"

                - service: light.turn_on
                  target: { entity_id: "{{ active_entity }}" }
                  data:
                    brightness: "{{ new_br }}"
                    transition: "{{ trans_val }}"
                - delay: { milliseconds: "{{ delay_val }}" }

      # 4. STOP (Cluster 8)
      - conditions: "{{ command == 'stop' and cluster_id == 8 }}"
        sequence:
          - stop: "Stopped Dimming"

      # 5. CUSTOM ACTIONS (Cluster 5)
      - conditions: "{{ cluster_id == 5 and command in ['hold', 'release'] }}"
        sequence:
          - choose:
              - conditions: "{{ args[0] == 3329 and command == 'hold' }}"
                sequence: !input arrow_left_hold
              - conditions: "{{ args[0] == 3329 and command == 'release' }}"
                sequence: !input arrow_left_release
              - conditions: "{{ args[0] == 3328 and command == 'hold' }}"
                sequence: !input arrow_right_hold
              - conditions: "{{ args[0] == 3328 and command == 'release' }}"
                sequence: !input arrow_right_release
