---
views:
  - title: {{ home_assistant_dashboard_title | to_json }}
    path: home
    type: sections
    max_columns: 2
    top_margin: false
    sections:
      - type: grid
        cards:
          - type: grid
            columns: 3
            square: false
            cards:
              - type: tile
                entity: {{ home_assistant_entity_ids.presence }}
                name: Home
                icon: mdi:home-account
              - type: tile
                entity: binary_sensor.any_lights_on
                name: All lights
                icon: mdi:lightbulb-group
                tap_action:
                  action: perform-action
                  perform_action: script.toggle_all_lights
              - type: button
                name: Lights
                icon: mdi:lightbulb-multiple-outline
                tap_action:
                  action: navigate
                  navigation_path: /{{ home_assistant_dashboard_slug }}/lights
      - type: grid
        cards:
          # Each template returns complete card configs. Adding include,
          # exclude, sort, or unique filters routes the cards through the
          # entity pipeline and drops them.
          - type: custom:auto-entities
            card:
              type: grid
              columns: 2
              square: false
            card_param: cards
            filter:
              template: |-
                {% raw %}{% set ns = namespace(cards=[]) %}
                {% for area in areas() %}
                {% set card = {'type': 'area', 'area': area, 'display_type': 'compact',
                               'features': [{'type': 'area-controls', 'controls': ['light']}]} %}
                {% set ns.cards = ns.cards + [card] %}
                {% endfor %}
                {{ ns.cards }}{% endraw %}

  - title: Lights
    path: lights
    type: sections
    max_columns: 2
    top_margin: false
    subview: true
    back_path: /{{ home_assistant_dashboard_slug }}/home
    sections:
      - type: grid
        cards:
          - type: custom:auto-entities
            card:
              type: grid
              columns: 1
              square: false
            card_param: cards
            filter:
              template: |-
                {% raw %}{% set ns = namespace(cards=[]) %}
                {% for light in states.light | rejectattr('attributes.entity_id', 'defined') | sort(attribute='name') %}
                {% set card = {'type': 'tile', 'entity': light.entity_id,
                               'features': [{'type': 'light-brightness'}]} %}
                {% set ns.cards = ns.cards + [card] %}
                {% endfor %}
                {{ ns.cards }}{% endraw %}
