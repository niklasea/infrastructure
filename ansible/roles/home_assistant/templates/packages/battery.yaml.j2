---
automation:
  - id: battery_device_offline
    alias: Battery device offline
    mode: queued
    max: 10
    trigger:
      - platform: state
        entity_id: {{ home_assistant_battery_devices | map(attribute='entity') | list | to_json }}
        to: "unavailable"
        for: "12:00:00"
    action:
      - service: notify.send_message
        continue_on_error: true
        target:
          entity_id: {{ home_assistant_notify.email }}
        data:
          title: "Battery device offline"
          message: >-
            {% raw %}{{ trigger.to_state.name }} ({{ trigger.entity_id }}) has been unavailable for 12 hours.{% endraw %}

      - service: notify.send_message
        continue_on_error: true
        target:
          entity_id: {{ home_assistant_notify.mobile }}
        data:
          title: "Battery device offline"
          message: >-
            {% raw %}{{ trigger.to_state.name }} ({{ trigger.entity_id }}) has been unavailable for 12 hours.{% endraw %}

  - id: battery_low_summary
    alias: Battery low summary
    mode: single
    trigger:
      - platform: time
        at: "09:00:00"
    action:
      - variables:
          battery_device_entities: {{ home_assistant_battery_devices | map(attribute='entity') | list | to_json }}
      - variables:
          low_battery_message: >-
            {% raw %}{% set ns = namespace(parts=[]) %}
            {% for entity in battery_device_entities %}
              {% set device = device_id(entity) %}
              {% if device %}
                {% set device_name = device_attr(device, 'name_by_user') or device_attr(device, 'name') %}
                {% for battery in device_entities(device) | expand | selectattr('attributes.device_class', 'eq', 'battery') %}
                  {% if battery.state | float(101) < 10 %}
                    {% set ns.parts = ns.parts + [device_name ~ ' battery: ' ~ battery.state ~ '%'] %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endfor %}
            {{ ns.parts | join(', ') }}{% endraw %}

      - condition: template
        value_template: "{% raw %}{{ low_battery_message | trim != '' }}{% endraw %}"
      - service: notify.send_message
        continue_on_error: true
        target:
          entity_id: {{ home_assistant_notify.email }}
        data:
          title: "Battery low"
          message: "{% raw %}{{ low_battery_message | trim }}{% endraw %}"
      - service: notify.send_message
        continue_on_error: true
        target:
          entity_id: {{ home_assistant_notify.mobile }}
        data:
          title: "Battery low"
          message: "{% raw %}{{ low_battery_message | trim }}{% endraw %}"
