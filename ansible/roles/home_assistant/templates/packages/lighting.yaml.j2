---
automation:
  - id: living_room_lights_on_door_open
    alias: Living room lights on door open (evening)
    mode: single
    trigger:
      - platform: state
        entity_id: {{ home_assistant_entity_ids.door_sensor }}
        from: "off"
        to: "on"
    condition:
      - condition: time
        after: "18:00:00"
        before: "03:00:00"
    action:
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.living_room_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.living_room_light }}
            data:
              brightness_pct: 100
              transition: 5
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.work_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.work_light }}
            data:
              brightness_pct: 75
              transition: 5
