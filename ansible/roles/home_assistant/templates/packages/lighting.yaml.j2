---
script:
  evening_lights:
    alias: Evening lights
    mode: single
    sequence:
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.living_room_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.living_room_light }}
            data:
              brightness_pct: 100
              transition: 5
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.work_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.work_light }}
            data:
              brightness_pct: 75
              transition: 5

  styrbar_target_dip:
    alias: STYRBAR target dip
    mode: queued
    max: 5
    fields:
      target_entity:
        description: Light to dip
    sequence:
      - variables:
          was_on: "{% raw %}{{ is_state(target_entity, 'on') }}{% endraw %}"
          old_brightness: "{% raw %}{{ state_attr(target_entity, 'brightness') | int(0) }}{% endraw %}"
      - variables:
          restore_brightness: "{% raw %}{{ old_brightness | int }}{% endraw %}"
      - choose:
          - conditions: "{% raw %}{{ was_on | bool and (old_brightness | int) > 0 }}{% endraw %}"
            sequence:
              - variables:
                  dip_brightness: "{% raw %}{{ [(old_brightness | int) - 26, 1] | max }}{% endraw %}"
              - service: light.turn_on
                target:
                  entity_id: "{% raw %}{{ target_entity }}{% endraw %}"
                data:
                  brightness: "{% raw %}{{ dip_brightness }}{% endraw %}"
                  transition: 0.1
              - delay:
                  milliseconds: 150
              - condition: state
                entity_id: "{% raw %}{{ target_entity }}{% endraw %}"
                state: "on"
              - service: light.turn_on
                target:
                  entity_id: "{% raw %}{{ target_entity }}{% endraw %}"
                data:
                  brightness: "{% raw %}{{ restore_brightness }}{% endraw %}"
                  transition: 0.2

          - conditions: "{% raw %}{{ not (was_on | bool) }}{% endraw %}"
            sequence:
              - service: light.turn_on
                target:
                  entity_id: "{% raw %}{{ target_entity }}{% endraw %}"
                data:
                  brightness: 25
                  transition: 0.1
              - delay:
                  milliseconds: 150
              - service: light.turn_off
                target:
                  entity_id: "{% raw %}{{ target_entity }}{% endraw %}"
                data:
                  transition: 0.2

automation:
  - id: living_room_lights_on_door_open
    alias: Living room lights on door open (evening)
    mode: single
    trigger:
      - platform: state
        entity_id: {{ home_assistant_entity_ids.door_sensor }}
        from: "off"
        to: "on"
    condition:
      - condition: time
        after: "18:00:00"
        before: "03:00:00"
      - condition: template
        value_template: >-
          {% raw %}{{ states.light
             | rejectattr('attributes.entity_id', 'defined')
             | selectattr('state', 'in', ['off', 'unavailable'])
             | map(attribute='last_changed')
             | map('as_timestamp')
             | select('gt', as_timestamp(now()) - 300)
             | list | count == 0 }}{% endraw %}

    action:
      - service: script.evening_lights

  - id: door_open_while_away
    alias: Door open while away
    mode: single
    trigger:
      - platform: state
        entity_id: {{ home_assistant_entity_ids.door_sensor }}
        to: "on"
        for: "00:02:00"
      - platform: state
        entity_id: {{ home_assistant_entity_ids.presence }}
        to: "0"
        for: "00:02:00"
      - platform: homeassistant
        event: start
    condition:
      - condition: numeric_state
        entity_id: {{ home_assistant_entity_ids.presence }}
        below: 1
      - condition: state
        entity_id: {{ home_assistant_entity_ids.door_sensor }}
        state: "on"
    action:
      - service: notify.send_message
        continue_on_error: true
        target:
          entity_id: {{ home_assistant_notify.mobile }}
        data:
          title: "Door left open"
          message: "The front door is open while nobody is home."

  - id: living_room_lights_on_already_home
    alias: Living room lights on when already home (evening)
    mode: single
    trigger:
      - platform: time
        at: "18:00:00"
    condition:
      - condition: numeric_state
        entity_id: {{ home_assistant_entity_ids.presence }}
        above: 0
    action:
      - service: script.evening_lights

  - id: bedside_table_on_nightly
    alias: Bedside table on at night
    mode: single
    trigger:
      - platform: time
        at: "22:00:00"
    condition:
      - condition: numeric_state
        entity_id: {{ home_assistant_entity_ids.presence }}
        above: 0
    action:
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.bedside_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.bedside_light }}
            data:
              transition: 5

  - id: styrbar_living_room
    alias: STYRBAR living room
    use_blueprint:
      path: kiann/styrbar_zha.yaml
      input:
        switch_remote: {{ home_assistant_styrbar.device_id }}
        targets: {{ home_assistant_styrbar.targets | to_json }}
        selected_target: input_number.styrbar_target
        enable_flash: true
        force_brightness: false
        brightness_pct: 50
        repeat_delay: 200
        brightness_step_pct: 5
        transition_time: 0.2

input_number:
  styrbar_target:
    name: STYRBAR target
    min: 0
    max: {{ (home_assistant_styrbar.targets | length) - 1 }}
    step: 1
    mode: slider
