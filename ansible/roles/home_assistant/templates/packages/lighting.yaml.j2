---
automation:
  - id: living_room_lights_on_door_open
    alias: Living room lights on when home (evening)
    mode: single
    trigger:
      - platform: state
        entity_id: {{ home_assistant_entity_ids.door_sensor }}
        from: "off"
        to: "on"
      - platform: time
        at: "18:00:00"
    condition:
      # The time trigger sits on the window boundary.
      - condition: time
        after: "17:59:00"
        before: "03:00:00"
      - condition: numeric_state
        entity_id: {{ home_assistant_entity_ids.presence }}
        above: 0
    action:
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.living_room_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.living_room_light }}
            data:
              brightness_pct: 100
              transition: 5
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.work_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.work_light }}
            data:
              brightness_pct: 75
              transition: 5

  - id: bedside_table_on_nightly
    alias: Bedside table on at night
    mode: single
    trigger:
      - platform: time
        at: "22:00:00"
    condition:
      - condition: numeric_state
        entity_id: {{ home_assistant_entity_ids.presence }}
        above: 0
    action:
      - if:
          - condition: state
            entity_id: {{ home_assistant_entity_ids.bedside_light }}
            state: "off"
        then:
          - service: light.turn_on
            target:
              entity_id: {{ home_assistant_entity_ids.bedside_light }}
            data:
              transition: 5

  - id: styrbar_living_room
    alias: STYRBAR living room
    use_blueprint:
      path: kiann/styrbar_zha.yaml
      input:
        switch_remote: {{ home_assistant_styrbar.device_id }}
        targets: {{ home_assistant_styrbar.targets | to_json }}
        selected_target: input_number.styrbar_target
        enable_flash: true
        force_brightness: false
        brightness_pct: 50
        repeat_delay: 150
        brightness_step_pct: 10
        transition_time: 0.3

input_number:
  styrbar_target:
    name: STYRBAR target
    min: 0
    max: {{ (home_assistant_styrbar.targets | length) - 1 }}
    step: 1
    mode: slider
