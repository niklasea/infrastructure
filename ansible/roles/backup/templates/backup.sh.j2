#!/usr/bin/env bash
# Managed by Ansible. Do not edit manually.
set -Eeuo pipefail
umask 077

readonly job="{{ item.name }}"
readonly tmpdir="$(/usr/bin/mktemp -d "/var/tmp/backup-${job}.XXXXXX")"

log() {
    logger -t "backup[${job}]" "$*"
}

cleanup() {
{% for command in item.cleanup | default([]) %}
    {{ command }} || true
{% endfor %}
    /usr/bin/rm -rf "${tmpdir}" || true
}

on_error() {
    local rc=$?
    log "FAILED: ${BASH_COMMAND} (rc=${rc})"
}

trap cleanup EXIT
trap on_error ERR
trap 'log "interrupted"; exit 130' INT
trap 'log "terminated"; exit 143' TERM

{% if item.mount is defined %}
if ! mountpoint -q "{{ item.mount }}"; then
    log "backup target {{ item.mount }} is not mounted"
    false
fi
{% endif %}

{% for command in item.commands %}
{{ command }}
{% endfor %}

log "completed successfully"
