---
# https://immich.app/docs/install/docker-compose
name: immich

services:
  immich-server:
    container_name: immich_server
    image: ghcr.io/immich-app/immich-server:${IMMICH_VERSION:-release}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 4G
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    volumes:
      - {{ immich_upload_dir }}:/data
      - /etc/localtime:/etc/localtime:ro
    env_file:
      - .env
    ports:
      - 127.0.0.1:{{ immich_port }}:2283
    depends_on:
      - redis
      - database
    healthcheck:
      disable: false

  immich-machine-learning:
    container_name: immich_machine_learning
    image: ghcr.io/immich-app/immich-machine-learning:${IMMICH_VERSION:-release}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 4G
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    volumes:
      - model-cache:/cache
    env_file:
      - .env
    environment:
      MACHINE_LEARNING_MODEL_REVISION: v2
    healthcheck:
      disable: false

  redis:
    container_name: immich_redis
    image: {{ immich_valkey_image }}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 1G
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: redis-cli ping | grep -q PONG || exit 1

  database:
    container_name: immich_postgres
    image: {{ immich_postgres_image }}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 2G
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    environment:
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_DB: ${DB_DATABASE_NAME}
      POSTGRES_INITDB_ARGS: '--data-checksums'
    volumes:
      - {{ immich_db_data_dir }}:/var/lib/postgresql/data
    shm_size: 128mb
    healthcheck:
      disable: false

volumes:
  model-cache:
