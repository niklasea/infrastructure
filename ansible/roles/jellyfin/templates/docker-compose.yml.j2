services:
  jellyfin:
    image: jellyfin/jellyfin:{{ jellyfin_version }}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          # Metadata refreshes crash the container due to OOM if limit is less than 2GB
          memory: 2G
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    volumes:
      - jellyfin-cache:/cache
      - {{ jellyfin_config_dir }}:/config
      - {{ jellyfin_media_dir }}:/media:ro
    ports:
      # DLNA
      - 1900:1900/udp
      - 7359:7359/udp
    networks:
      reverse_proxy:
        ipv4_address: {{ haproxy_docker_internal_network | ansible.utils.ipaddr('6') | ansible.utils.ipaddr('address') }}

volumes:
  jellyfin-cache:

networks:
  reverse_proxy:
    external: true
