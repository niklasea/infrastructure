{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ opencode_default_model_alias }}",
  "providers": {
    "{{ opencode_default_provider }}": {
      "models": {
        "{{ opencode_default_model_id }}-{{ opencode_default_effort }}": {
          "modelID": "{{ opencode_default_model_id }}",
          "name": "{{ opencode_default_model_name }} ({{ opencode_default_effort | capitalize }})",
          "settings": {
            "reasoningEffort": "{{ opencode_default_effort }}"
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": {{ opencode_default_model_context }},
            "output": {{ opencode_default_model_output }}
          }
        }
      }
    }
  },
  "default_agent": "{{ opencode_default_agent }}",
  "update": "disable",
  "websearch": {
    "provider": "{{ opencode_websearch_provider }}"
  },
  "warming": false,
  "snapshots": {{ 'true' if opencode_snapshots | bool else 'false' }},
  "formatter": false,
  "tool_output": {
    "max_lines": {{ opencode_tool_output_max_lines }},
    "max_bytes": {{ opencode_tool_output_max_bytes }}
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**"
    ]
  },
  "compaction": {
    "auto": true,
    "background": {{ 'true' if opencode_compaction_background | bool else 'false' }},
    "keep": {
      "tokens": {{ opencode_compaction_keep_tokens }}
    },
    "buffer": "{{ opencode_compaction_buffer }}"
  },
  "agents": {
    "compaction": {
      "model": "{{ opencode_default_model }}"
    },
    "build": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 50
    },
    "plan": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 40,
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 40,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "explore": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 20,
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
