      "effect": "allow"
    },
    {
      "action": "mcp.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plugin.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plugin.use",
      "resource": "opencode.config.policy",
      "effect": "allow"
    },
    {
      "action": "plugin.use",
      "resource": "opencode.websearch.{{ opencode_websearch_provider }}",
      "effect": "allow"
    },
    {
      "action": "websearch.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch.use",
      "resource": "{{ opencode_websearch_provider }}",
      "effect": "allow"
    },
