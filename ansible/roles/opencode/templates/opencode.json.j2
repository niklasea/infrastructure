{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ opencode_default_model_alias }}",
  "providers": {
    "deepseek": {
      "models": {
        "deepseek-flash-{{ opencode_default_effort }}": {
          "modelID": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash ({{ opencode_default_effort | capitalize }})",
          "settings": {
            "reasoningEffort": "{{ opencode_default_effort }}"
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      }
    }
  },
  "default_agent": "{{ opencode_default_agent }}",
  "update": "disable",
  "websearch": {
    "provider": "{{ opencode_websearch_provider }}"
  },
  "warming": false,
  "snapshots": {{ 'true' if opencode_snapshots | bool else 'false' }},
  "formatter": false,
  "tool_output": {
    "max_lines": {{ opencode_tool_output_max_lines }},
    "max_bytes": {{ opencode_tool_output_max_bytes }}
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**"
    ]
  },
  "compaction": {
    "auto": true,
    "background": {{ 'true' if opencode_compaction_background | bool else 'false' }},
    "keep": {
      "tokens": {{ opencode_compaction_keep_tokens }}
    },
    "buffer": "{{ opencode_compaction_buffer }}"
  },
  "agents": {
    "compaction": {
      "model": "{{ opencode_default_model }}"
    },
    "build": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 50
    },
    "plan": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 30,
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 40,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "explore": {
      "model": "{{ opencode_default_model_alias }}",
      "steps": 20,
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".git-credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.git-credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".netrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.netrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*opencode.db*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*service.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": ".ssh/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".git/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/.git/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".config/opencode/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/.config/opencode/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "su *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "systemctl *",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "deepseek",
      "effect": "allow"
    },
    {
      "action": "mcp.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:sudo *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:su *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:rm -rf *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:docker *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:systemctl *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*service.json",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:*opencode.db*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/.git/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/.config/opencode/*",
      "effect": "deny"
    }
  ]
}
