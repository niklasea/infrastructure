[Unit]
Description=Check restic repository data
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ restic_server_repo_root }}

[Service]
Type=oneshot
User={{ restic_server_user }}
Group={{ restic_server_group }}
Environment=HOME={{ restic_server_home }}
Environment=RESTIC_CACHE_DIR={{ restic_server_cache_dir }}
ExecStart=/usr/local/sbin/restic-check {{ restic_server_check_read_data_subset | replace('%', '%%') }}
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=24h
