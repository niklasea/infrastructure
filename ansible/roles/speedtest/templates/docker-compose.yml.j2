---
services:
  librespeed:
    image: adolfintel/speedtest:{{ speedtest_librespeed_version }}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 1G
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
    security_opt:
      - no-new-privileges:true
    ports:
      - 127.0.0.1:8004:80
    environment:
      MODE: standalone

  fireperf:
    image: ghcr.io/niklasea/fireperf:{{ speedtest_fireperf_version }}
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 1G
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    ports:
      - {{ speedtest_fireperf_port }}:5001
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
